# ===============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===============================================

# 1. Database Credentials (PostgreSQL)
POSTGRES_USER=editor_user
POSTGRES_PASSWORD=generate_a_secure_password_here_min_32_chars
POSTGRES_DB=video_editor_prod

# 2. Application Security
# Generate a strong 64-char key with: `openssl rand -hex 32`
SECRET_KEY=generate_a_random_hex_secret_key_here

# 3. Domain & Networking
DOMAIN_NAME=yourdomain.com
API_PORT=8000
FRONTEND_PORT=3000

# 4. Storage & Performance
MAX_UPLOAD_SIZE_MB=10240
FFMPEG_THREADS=4
WORKER_CONCURRENCY=4
